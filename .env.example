# TijaraGuard Configuration Template (variable NAMES only — never commit real secrets)

# Core Execution Mode: SIMULATED_NO_SEND (default) | LOOPBACK_LIVE | LIVE
TIJARAGUARD_MODE=SIMULATED_NO_SEND
TIJARAGUARD_TENANT_ID=default

# Persistence & Catalog Paths (use a private POSIX 0700 directory in production)
TIJARAGUARD_STATE_DIR=/var/lib/tijaraguard
TIJARAGUARD_CATALOG_PATH=/etc/tijaraguard/catalog.json
TIJARAGUARD_BACKUP_DIR=/var/lib/tijaraguard/backups

# Required Cryptographic Secrets in LIVE mode (generate >= 32 random hex bytes, e.g. openssl rand -hex 32)
TIJARAGUARD_APPROVAL_SECRET=
TIJARAGUARD_CONTACT_HASH_KEY=
TIJARAGUARD_API_KEY=

# HTTP Server Binding & Limits
TIJARAGUARD_HOST=127.0.0.1
TIJARAGUARD_PORT=8080
TIJARAGUARD_RATE_LIMIT_PER_MIN=120
TIJARAGUARD_WEBHOOK_REPLAY_WINDOW_SECONDS=300
TIJARAGUARD_RETENTION_DAYS=30
TIJARAGUARD_ROUTE_TTL_SECONDS=86400

# AI Provider Routing
TIJARAGUARD_DEFAULT_PROVIDER=
TIJARAGUARD_PROVIDER_SIMPLE=
TIJARAGUARD_PROVIDER_STANDARD=
TIJARAGUARD_PROVIDER_COMPLEX=
TIJARAGUARD_ALLOW_FALLBACK=false
TIJARAGUARD_FALLBACK_CHAIN=
TIJARAGUARD_FALLBACK_TO_TEMPLATE=true

# Cloud AI Providers (configure any one or more)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Optional Local Ollama Inference (not required)
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5:7b

# Official WhatsApp Business Cloud API
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# Official Telegram Bot API
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Official Chatwoot Integration
CHATWOOT_ENABLED=false
CHATWOOT_BASE_URL=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_API_ACCESS_TOKEN=
CHATWOOT_WEBHOOK_SECRET=

# Generic Signed Webhook Channel
TIJARAGUARD_WEBHOOK_ENABLED=false
TIJARAGUARD_WEBHOOK_INBOUND_SECRET=
TIJARAGUARD_WEBHOOK_OUTBOUND_URL=
TIJARAGUARD_WEBHOOK_OUTBOUND_SECRET=
TIJARAGUARD_WEBHOOK_LOOKUP_URL=
